    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:local": "FIREBASE_PROJECT_ID=demo-tooltime FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIRESTORE_EMULATOR_HOST=127.0.0.1:8085 FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199 INVITE_HMAC_SECRET=local-development-secret-change-me-123 ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173 node --watch server.js",
    "emulators": "XDG_CONFIG_HOME=/tmp/tooltime-firebase-config firebase emulators:start --only auth,firestore,storage --config ../firebase.json --project demo-tooltime",
    "seed:local": "FIREBASE_PROJECT_ID=demo-tooltime FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIRESTORE_EMULATOR_HOST=127.0.0.1:8085 node scripts/seedEmulator.js",
    "test": "node test_converter.js",
    "test:email": "node --test tests/emailService.test.js tests/invitationDeliveryService.test.js",
    "test:rules": "node --test tests/firestoreRules.test.js",
    "test:local-api": "node tests/localApiSmoke.js",
    "bootstrap": "node scripts/bootstrap.js",
    "cleanup:legacy": "node scripts/cleanLegacyDemoData.js",
    "grant:superadmin": "node scripts/grantSuperadmin.js"
  },
