rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/(default)/documents/users/$(request.auth.uid); }
    function isSuperadmin() {
      return signedIn() && (
        ('platformRole' in request.auth.token && request.auth.token.platformRole == 'superadmin') ||
        (firestore.exists(userPath()) && firestore.get(userPath()).data.platformRole == 'superadmin')
      );
    }
    function member(tenantId) { return firestore.get(/databases/(default)/documents/tenants/$(tenantId)/members/$(request.auth.uid)); }
    function activeTenant(tenantId) { return firestore.get(/databases/(default)/documents/tenants/$(tenantId)).data.status == 'active'; }
    function activeMember(tenantId) { return signedIn() && activeTenant(tenantId) && member(tenantId).data.status == 'active'; }
    function tenantAdmin(tenantId) { return isSuperadmin() || (activeMember(tenantId) && member(tenantId).data.role == 'admin'); }
    match /tenants/{tenantId}/branding/{fileName} {
      allow read: if isSuperadmin() || activeMember(tenantId);
      allow write: if tenantAdmin(tenantId) && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    match /tenants/{tenantId}/projects/{projectId}/{allPaths=**} {
      allow read: if isSuperadmin() || activeMember(tenantId);
      allow write: if tenantAdmin(tenantId) && request.resource.size < 100 * 1024 * 1024;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
