rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSuperadmin() { return signedIn() && 'platformRole' in request.auth.token && request.auth.token.platformRole == 'superadmin'; }
    function memberPath(tenantId) { return /databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid); }
    function isActiveTenant(tenantId) { return exists(/databases/$(database)/documents/tenants/$(tenantId)) && get(/databases/$(database)/documents/tenants/$(tenantId)).data.status == 'active'; }
    function isActiveMember(tenantId) { return signedIn() && isActiveTenant(tenantId) && exists(memberPath(tenantId)) && get(memberPath(tenantId)).data.status == 'active'; }
    function tenantRole(tenantId) { return get(memberPath(tenantId)).data.role; }
    function hasTenantRole(tenantId, roles) { return isSuperadmin() || (isActiveMember(tenantId) && tenantRole(tenantId) in roles); }
    function projectAssigned(tenantId, projectId) {
      return hasTenantRole(tenantId, ['admin']) || (isActiveMember(tenantId) && get(memberPath(tenantId)).data.assignedProjectIds.hasAny([projectId]));
    }

    match /tenants/{tenantId} {
      allow read: if isSuperadmin() || isActiveMember(tenantId);
      allow create, update, delete: if isSuperadmin();
      match /members/{uid} {
        allow read: if isSuperadmin() || (isActiveMember(tenantId) && (request.auth.uid == uid || hasTenantRole(tenantId, ['admin'])));
        allow write: if false;
        match /devices/{deviceId} {
          allow read: if isSuperadmin() || (isActiveMember(tenantId) && (request.auth.uid == uid || hasTenantRole(tenantId, ['admin'])));
          allow write: if false;
        }
      }
      match /invites/{inviteId} { allow read, write: if false; }
      match /projects/{projectId} {
        allow read: if projectAssigned(tenantId, projectId);
        allow create, update, delete: if hasTenantRole(tenantId, ['admin']);
        match /positions/{id} {
          allow read: if projectAssigned(tenantId, projectId);
          allow write: if hasTenantRole(tenantId, ['admin', 'bauleiter']);
        }
        match /rooms/{id} {
          allow read: if projectAssigned(tenantId, projectId);
          allow create, update: if projectAssigned(tenantId, projectId) && hasTenantRole(tenantId, ['admin', 'bauleiter', 'monteur']);
          allow delete: if hasTenantRole(tenantId, ['admin']);
        }
        match /bookings/{id} {
          allow read: if projectAssigned(tenantId, projectId);
          allow create: if projectAssigned(tenantId, projectId) && request.resource.data.createdByUid == request.auth.uid;
          allow update, delete: if hasTenantRole(tenantId, ['admin', 'bauleiter']);
        }
        match /addendums/{id} {
          allow read: if projectAssigned(tenantId, projectId);
          allow create: if projectAssigned(tenantId, projectId) && request.resource.data.createdByUid == request.auth.uid;
          allow update: if projectAssigned(tenantId, projectId) && hasTenantRole(tenantId, ['admin', 'bauleiter', 'kaufmaennisch']);
          allow delete: if hasTenantRole(tenantId, ['admin']);
        }
        match /{otherCollection}/{id} {
          allow read: if projectAssigned(tenantId, projectId);
          allow write: if hasTenantRole(tenantId, ['admin', 'bauleiter']);
        }
      }
    }
    match /inviteCodeIndex/{id} { allow read, write: if false; }
    match /inviteQrIndex/{id} { allow read, write: if false; }
    match /rateLimits/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
