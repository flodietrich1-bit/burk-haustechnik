lTxt></OutlineText></CompleteText></Description></Item><Item ID="id6327" RNoPart="80"><RefDescr>Rep</RefDescr><RefRNo IDRef="id6146"/><Qty>20.000</Qty><QU>Stk</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Überwandscheibe 16 x 2,25 mm</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Überwandscheibe 16 x 2,25 mm</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id6328" RNoPart="81"><RefDescr>Rep</RefDescr><RefRNo IDRef="id6146"/><Qty>20.000</Qty><QU>Stk</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Doppelwandscheibe 20 x 2,5 mm </span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Doppelwandscheibe 20 x 2,5 mm</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id6150" RNoPart="82"><Qty>1.000</Qty><QU>Stk</QU><Description><CompleteText><ComplTSB>Yes</ComplTSB><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Sanitärverteiler DN 65</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">bestehend aus:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Verteilerkammer aus Edelstahl V4A mit aufgeschweißten Abgangsstutzen als Gewindestutzen oder Rohrstutzen für Pressfittings oder Rohrstutzen aus Edelstahlrohr mit Vorschweißflanschen nach DIN, PN 16 und Muffe 1/2&#x22; für Entleerung.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Stutzenhöhe ist auf gleiche Spindelhöhe der Absperrorgane abgestimmt.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Verteiler ist werkseitig druckgeprüft, gebeizt und passiviert.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Technische Daten:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Einsatzbereich Sanitär</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Kammerabmessung DN 65 </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Wasser-Durchsatz 20 cbm/h</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- max. Betriebstemperatur 110 °C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- max. Betriebsüberdruck 10 bar</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Anzahl Verteilerabgänge: 5</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">   1,30 m   Länge der Verteilerkammer</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">   3 STCK  Flanschstutzen DN 40 / PN 16</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">   1 STCK  Flanschstutzen DN 50 / PN 16</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">   1 STCK  Flanschstutzen DN 65 / PN 16</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">   1 STCK  Entleerung 1/2&#x22;</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zubehör:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Dämmung Sanitärverteiler 2-teilig mit Spanngurten</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Verteiler fertig montiert einschl. Befestigungsmaterial an wie Konsolen, Dübel, Rohrschellen etc.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/></Text><TextComplement MarkLbl="11" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">Angeb. Fabr.,	 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;.........&#x27;</span></ComplBody><ComplTail><br/></ComplTail></TextComplement><TextComplement MarkLbl="12" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">Typ:				 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;.........&#x27;</span></ComplBody><ComplTail/></TextComplement></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Sanitärverteiler DN 65</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Remark ID="id8833"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Rohrbefestigung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Vor der Montageaufnahme ist mit dem Statiker ein Termin vor Ort zu vereinbaren, an dem die vorgesehenen Befestigungen und Verankerungen an den einzelnen Montageorten abgeklärt, geprüft und freigegeben werden. Der Aufwand hierfür ist in die Einheitspreise miteinzu­kalkulieren.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rohrbefestigung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Item ID="id8834" RNoPart="83"><RefDescr>Ref</RefDescr><Qty>14.000</Qty><QU>Stk</QU><Description><CompleteText><ComplTSB>Yes</ComplTSB><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rohrschelle NW DN 80</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">für die Befestigung von Trinkwasserleitungen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">mit flexiblem Anschlussgewinde M8/M10</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Verschlussschrauben mit Kombi-Kreuzschlitz mit Unverlierbarkeitsscheiben</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schallschutzgeprüft - mit hochelastischer Schallschutzeinlage</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">einschl. folgendem Zubehör:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gewindestab M10 verzinkt</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Sechskantmutter</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Unterlegscheibe</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Hammerkopfschraube</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Dübel</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">komplett montiert</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/></Text><TextComplement MarkLbl="11" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">angeb. Fabr.:	 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;.........&#x27;</span></ComplBody><ComplTail><br/></ComplTail></TextComplement><TextComplement MarkLbl="12" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">Typ:			 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;.........&#x27;</span></ComplBody><ComplTail/></TextComplement></DetailTxt><OutlineText><