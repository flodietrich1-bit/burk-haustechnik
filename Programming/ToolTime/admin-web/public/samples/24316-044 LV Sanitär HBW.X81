size:10pt;">&#x27;.........&#x27;</span></ComplBody><ComplTail/></TextComplement></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Isolation von Rohrleitungen DN 125</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id6445" RNoPart="31"><RefDescr>Rep</RefDescr><RefRNo IDRef="id6444"/><Qty>35.000</Qty><QU>m</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rohr DN 100</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rohr DN 100</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id6448" RNoPart="32"><RefDescr>Rep</RefDescr><RefRNo IDRef="id6444"/><Qty>6.000</Qty><QU>m</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rohr DN 70</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rohr DN 70</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id6462" RNoPart="33"><RefDescr>Ref</RefDescr><Qty>20.000</Qty><QU>m</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Abflussrohr DN 100, dampfdicht mit 5 mm starkem Isolierschlauch isolieren, einschl. Form- und Verbindungs­teile sowie Klebematerialien</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Abflussrohr DN 100, dampfdicht mit 5 mm starkem</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id10430" RNoPart="34"><RefDescr>Rep</RefDescr><RefRNo IDRef="id6462"/><Qty>6.000</Qty><QU>m</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Abflussrohr DN 70 </span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Abflussrohr DN 70</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id10431" RNoPart="35"><RefDescr>Rep</RefDescr><RefRNo IDRef="id6462"/><Qty>10.000</Qty><QU>m</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Abflussrohr DN 50</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Abflussrohr DN 50</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Remark ID="id7440"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;font-weight:bold;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">Grauwasser Hebeanlage</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Grauwasser Hebeanlage</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Item ID="id7441" RNoPart="36"><Qty>1.000</Qty><QU>Stk</QU><Description><CompleteText><ComplTSB>Yes</ComplTSB><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schmutzwassersammelbehälter</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">für Duschen/ Waschtische und Wasser</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schmutzwasser-Sammelbehälter aus Kunsstoff mit einem Behältervolumen von 270 Litern zum Anschluss von zwei Schmutzwasserpumpen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zum Lieferumfang gehören Zulaufdichtungen und Rohrleitungskomponenten zur Anbindung der Pumpe innerhalb des Sammelbehälters.</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Effektives Nutzvolumen 150 Liter. </span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Entwässerungskapazität von 1,8 bis 9m³/h anpassbar über die Steuerung</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Deckel ø380mm für Einbau der Pumpe, Montage und Wartung, verschraubt.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Behälter Abmasse: 752x700x700mm</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">Anschlüsse:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x horizontaler Zulauf DN100 als platzsparende Muffe in einer Höhe von 180mm</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x horizontaler Zulauf DN100 als platzsparende Muffe in einer Höhe von 520mm</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x vertikaler Zulauf DN100 als platzsparende Muffe (inkl. 1 x Muffendichtung DN 100) in einer Höhe von 700mm</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x DN40 Verbindungsmuffe für den Anschluss von z.B. einer Membranpumpe (inkl. 1x DN40 Dichtung)</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x DN75/50 Öffnung für die Be-/Entlüftungsleitung</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">Sammelbehälter gemäß EN 12050-2, geprüft</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Sammelbehälter: Polyethylen (PE)</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Deckel: Polyethylen (PE)</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Verschraubungen: Verzinkter Stahl</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Muffendichtung: Styrol-Butadien (SBR)</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rohrteile: Polyvinyl Chloride (PVC) und Polypropylen (PP)</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Behältermaße: l x w x h: 700x600x750 mm</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gewicht: 25.8 kg</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Fördermedium: Medientemperaturbereich: 0 .. 40 °C</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Maximale Partikelgröße: 50 mm</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zulassungen: CE,LGA,MORO,UKCA,SEPRO</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">EN-Nummer für LGA-Zulassung: EN 12050-1</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schutzart (gemäß IEC 34-5): IP68</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Isolationsklasse (IEC 85): F</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">einschl. folgendem Zubehör:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 Stk. Zulaufseitiger Absperrschieber DN100, PN25 aus PVC/Edelstahl mit Anschlusstutzen und vertikaler Betätigungsstange</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1x Druckabgang für Pumpen; Vorgefertigtes Rohrstück zum zusammenführen der Pumpen auf eine Rohrleitung aus PVC; Dimension 2&#x22;; mit 1x Absperrung und 2x Rückschlagventil sowie 2x Elastisches Übergangsstück (Druckschlauch zwischen Pumpe und Druckabgang)</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1x Füllstandssensor für den Behälter bestehend aus1x Rohr PVC D=50 0.45m; 1x Endkappe PVC D=50; 1x Sechskantnippel D8x1/4&#x22;; 1x Klemme mit Schraube D32-50; 1x Sensor kpl. RPS 0-1m M16x1.5; 1x Schlauch 10m</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">komplett montiert </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/></Text><TextComplement MarkLbl="11" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">angeb. Fabr.:	 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;.........&#x27;</span></ComplBody><ComplTail><br/></ComplTail></TextComplement><TextComplement MarkLbl="12" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">Typ:			 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;.........&#x27;</span></ComplBody><ComplTail/></TextComplement></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schmutzwassersammelbehälter</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id7442" RNoPart="37"><Qty>2.000</Qty><QU>Stk</QU><Description><CompleteText><ComplTSB>Yes</ComplTSB><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Vertikale 1-stufige Schmutzwasserpumpe</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">passend zu Schmutzwassersammelbehälter </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;"><span style="font-size:10pt;font-family:Arial;">aus Pos </span><span style="font-size:10pt;font-family:Arial;">01.36</span><span style="font-size:10pt;font-family:Arial;"> .</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">in Niro-Ausführung mit integriertem überflutbaren</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1-phasigen Motor mit Thermoschalter,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Isolationsklasse F. Die Pumpe ist ausgestattet mit einemBodenstützring, einem Tragegriff und einem</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">10 m Netzkabel. Die Pumpe besitzt ein VORTEX Laufrad mit 35 mm freiem Durchgang und ist geeignet zur</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Förderung von Oberflächenwasser, Grundwasser und</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schmutzwasser.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Mit doppelter Wellenabdichtung bestehend aus einer Gleitringdichtung und einer Ölsperrkammer, die mit einem unbedenklichem Spezialöl gefüllt ist.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Motor ist mit wartungsfreien, dauergeschmierten Wälzlagern ausgestattet, und kann freistehend aufgestellt werden oder an einem automatischen Kupplungssystem angeschlossen werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">Fördermedium:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Medientemperaturbereich: 0 .. 40 °C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Medientemperatur während des Betriebs: 30 °C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Dichte: 998.2 kg/m³</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Technische Daten:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Maximaler Förderstrom: 5.83 l/s</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Laufradtyp: VORTEX</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Maximale Partikelgröße: 35 mm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">Werkstoffe:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Pumpengehäuse: Edelstahl</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Pumpenmantel: EN 1.4301</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Pumpengehäuse: AISI 304</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Laufradwerkstoff: Edelstahl</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Laufrad: EN 1.4301</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Laufradwerkstoff gemäß ASTM: AISI 304</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">Installation:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Umgebungstemperatur: 0 .. 30 °C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anschlusstyp: Rp</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anschlussgröße: 2 inch</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Maximum installation depth: 7 m</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Automatischer Kupplungsfußkrümmer: Y</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Place of installation: Indoor/outdoor</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">Elektrische Daten:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Leistungsaufnahme P1: 1.25 kW</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Motortyp: PSC</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rated power - P2: 0.71 kW</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Netzfrequenz: 50 Hz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bemessungsspannung: 1 x 230 V</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Nennstrom: 5.44 A</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Cos phi - Leistungsfaktor: 0.98</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bemessungsdrehzahl: 2795 1/min</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Größe des Betriebskondensators: 16 µF/400 V</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schutzart (gemäß IEC 34-5): IP68</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Isolationsklasse (IEC 85): F</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Length of power cable: 10 m</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Art des Kabelsteckers: SCHUKO</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">Sonstiges:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Nettogewicht: 11.7 kg</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bruttogewicht: 12 kg</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">komplett montiert und elektrisch angeschlossen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/></Text><TextComplement MarkLbl="11" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">angeb. Fabr.:	 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;.........&#x27;</span></ComplBody><ComplTail><br/></ComplTail></TextComplement><TextComplement MarkLbl="12" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">Typ:			 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;.........&#x27;</span></ComplBody><ComplTail><br/></ComplTail></TextComplement></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Vertikale 1-stufige Schmutzwasserpumpe</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id7444" RNoPart="38"><Qty>1.000</Qty><QU>Stk</QU><Description><CompleteText><ComplTSB>Yes</ComplTSB><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Niveausteuerung Grauwasserhebeanlage</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Pumpensteuerung dient zur Füllstandsregelung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">des Pumpenbehälters mit den beiden Pumpen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bedienfeld an der Steuerung zum einstellen der unterschiedliche Schaltniveaus und Betriebsarten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">einschl. folgenden Funktionen:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Aufzeichnungsfunktion über die letzten Alarm und Störmeldungen</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Steuerung von 1 oder 2 Pumpen auf Basis der am Sensoreingang anliegenden Analogsignale (0-5 V, 0,5-3,5 V, 0-10 V, 0-20 mA, 4-20 mA) oder Digitalsignale (Schwimmerschalter)</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Unterstützung von bis zu fünf Steuerebenen für den Betrieb über analoge Niveausensoren oder über Schwimmerschalter</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Konfigurierbare Eingangs- und Ausgangsklemmen, die flexibel als Digitaleingang/-ausgang, Analogeingang oder Pt100/1000-Eingang genutzt werden können</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schutz vor einem Zusammenbrechen der Netzspannung bei gleichzeitigem Anlaufen der Pumpen nach einem Stromausfall durch Einschaltverzögerung</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schutz vor Druckstößen durch Blockieren und Verzögern eines schnellen Neustarts/gleichzeitigen Pumpenanlaufs</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Wahlmöglichkeit einer automatischen Alarmquittierung</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Einstellmöglichkeiten für Abschaltverzögerungen zur Anpassung an aktuelle Betriebsbedingungen</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anzeige des aktuellen Füllstands</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Alarmmeldung über integriertem Summer.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schnittstelle zur Ausgabe von Stör- und Betriebsmeldungen</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">Alarmmeldung bei:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Überlast (Förderleistung/Stromaufnahme)</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Trockenlauf</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Hohem Füllstand</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Phasenfolgefehler und Phasenausfall</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Sensorfehler oder widersprüchlichen Sensorwerten</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Eindringen von Flüssigkeit in den Motor</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Überlauf</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zu vielen Neustarts</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Überhitzung der Pumpe.</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">Art der Steuerung:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Strommessung (Ja/Nein): Ja</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">Technische Daten:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zulassungen: CE,EAC,UKCA,MOROCCO,RCM</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anzahl Pumpen: 2</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Werkstoffe:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schaltschrank: Kunststoff</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Installation:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Umgebungstemperatur: 30 °C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Cabinet mounting: Wandmontage</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Masseanschluss: N, PE</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">Elektrische Daten:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Netzfrequenz: 50 / 60 Hz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Nennspannung 2. Wert: 1 x 110-240 V [3 x 200-460 V]</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Nennstrom: 1-9 A</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Größe des Betriebskondensators: N/A µF</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Größe des Anlaufkondensators: N/A µF</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Einschaltart: Direct-on-line (DOL)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schutzart (gemäß IEC 34-5): IP54</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;"><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">Sonstiges</span><span style="font-size:10pt;font-family:Arial;">:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Nettogewicht: 2 kg</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bruttogewicht: 2.79 kg</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Versandvol.: 0.015 m³</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">komplett montiert und elektrisch angeschlossen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/></Text><TextComplement MarkLbl="11" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">angeb. Fabr.:	 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;.........&#x27;</span></ComplBody><ComplTail><br/></ComplTail></TextComplement><TextComplement MarkLbl="12" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">Typ:			 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;.........&#x27;</span></ComplBody><ComplTail/></TextComplement></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Niveausteuerung Grauwasserhebeanlage</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Remark ID="id14522"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;font-weight:bold;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">Schmutzwasser Hebeanlage</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schmutzwasser Hebeanlage</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Item ID="id14523" RNoPart="39"><Qty>1.000</Qty><QU>Stk</QU><Description><CompleteText><ComplTSB>Yes</ComplTSB><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schmutzwassersammelbehälter 270ltr.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">für Duschen/ Waschtische und Wasser</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zum Lieferumfang gehören Zulaufdichtungen und Rohrleitungskomponenten zur Anbindung der Pumpe innerhalb des Sammelbehälters.</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Effektives Nutzvolumen 150 Liter. </span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Entwässerungskapazität von 1,8 bis 9m³/h anpassbar über die Steuerung</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Deckel ø380mm für Einbau der Pumpe, Montage und Wartung, verschraubt.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Behälter Abmasse: 752x700x700mm</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">Anschlüsse:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x horizontaler Zulauf DN100 als platzsparende Muffe in einer Höhe von 180mm</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x horizontaler Zulauf DN100 als platzsparende Muffe in einer Höhe von 520mm</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x vertikaler Zulauf DN100 als platzsparende Muffe (inkl. 1 x Muffendichtung DN 100) in einer Höhe von 700mm</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x DN40 Verbindungsmuffe für den Anschluss von z.B. einer Membranpumpe (inkl. 1x DN40 Dichtung)</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x DN75/50 Öffnung für die Be-/Entlüftungsleitung</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">Sammelbehälter gemäß EN 12050-2, geprüft</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Sammelbehälter: Polyethylen (PE)</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Deckel: Polyethylen (PE)</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Verschraubungen: Verzinkter Stahl</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Muffendichtung: Styrol-Butadien (SBR)</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rohrteile: Polyvinyl Chloride (PVC) und Polypropylen (PP)</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Behältermaße: l x w x h: 700x600x750 mm</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gewicht: 25.8 kg</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Fördermedium: Medientemperaturbereich: 0 .. 40 °C</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Maximale Partikelgröße: 50 mm</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zulassungen: CE,LGA,MORO,UKCA,SEPRO</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">EN-Nummer für LGA-Zulassung: EN 12050-1</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schutzart (gemäß IEC 34-5): IP68</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Isolationsklasse (IEC 85): F</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">einschl. folgendem Zubehör:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 Stk. Zulaufseitiger Absperrschieber DN100, PN25 aus PVC/Edelstahl mit Anschlusstutzen und vertikaler Betätigungsstange</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1x Druckabgang für Pumpen; Vorgefertigtes Rohrstück zum herausführen der Pumpenleitung aus dem Sammelbehälter. Rohrleitung aus PVC 2,0m; Dimension 2&#x22;; mit 1x Absperrung; 1x Rückschlagventil; 1x Elastisches Übergangsstück (Druckschlauch zwischen Pumpe und Druckabgang); </span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;tab-stops:18px 37px 75px 113px 151px 189px 226px 264px 302px 340px 378px 415px 453px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">1x Übergangsverschraubung 2&#x22;</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1x Füllstandssensor für den Behälter bestehend aus1x Rohr PVC D=50 0.45m; 1x Endkappe PVC D=50; 1x Sechskantnippel D8x1/4&#x22;; 1x Klemme mit Schraube D32-50; 1x Sensor kpl. RPS 0-1m M16x1.5; 1x Schlauch 5m</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">komplett montiert </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/></Text><TextComplement MarkLbl="11" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">angeb. Fabr.:	 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;.........&#x27;</span></ComplBody><ComplTail><br/></ComplTail></TextComplement><TextComplement MarkLbl="12" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">Typ:			 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;.........&#x27;</span></ComplBody><ComplTail/></TextComplement></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schmutzwassersammelbehälter 270ltr.</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id14524" RNoPart="40"><Qty>1.000</Qty><QU>Stk</QU><Description><CompleteText><ComplTSB>Yes</ComplTSB><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Vertikale 1-stufige Schmutzwasserpumpe</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">passend zu Schmutzwassersammelbehälter </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;"><span style="font-size:10pt;font-family:Arial;">aus Pos </span><span style="font-size:10pt;font-family:Arial;">01.39</span><span style="font-size:10pt;font-family:Arial;"> .</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">in Niro-Ausführung mit integriertem überflutbaren</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1-phasigen Motor mit Thermoschalter,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Isolationsklasse F. Die Pumpe ist ausgestattet mit einemBodenstützring, einem Tragegriff und einem</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">10 m Netzkabel. Die Pumpe besitzt ein VORTEX Laufrad mit 35 mm freiem Durchgang und ist geeignet zur</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Förderung von Oberflächenwasser, Grundwasser und</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schmutzwasser.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Mit doppelter Wellenabdichtung bestehend aus einer Gleitringdichtung und einer Ölsperrkammer, die mit einem unbedenklichem Spezialöl gefüllt ist.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Motor ist mit wartungsfreien, dauergeschmierten Wälzlagern ausgestattet, und kann freistehend aufgestellt werden oder an einem automatischen Kupplungssystem angeschlossen werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">Fördermedium:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Medientemperaturbereich: 0 .. 40 °C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Medientemperatur während des Betriebs: 30 °C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Dichte: 998.2 kg/m³</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Technische Daten:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Maximaler Förderstrom: 5.83 l/s</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Laufradtyp: VORTEX</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Maximale Partikelgröße: 35 mm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">Werkstoffe:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Pumpengehäuse: Edelstahl</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Pumpenmantel: EN 1.4301</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Pumpengehäuse: AISI 304</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Laufradwerkstoff: Edelstahl</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Laufrad: EN 1.4301</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Laufradwerkstoff gemäß ASTM: AISI 304</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">Installation:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Umgebungstemperatur: 0 .. 30 °C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anschlusstyp: Rp</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anschlussgröße: 2 inch</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Maximum installation depth: 7 m</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Automatischer Kupplungsfußkrümmer: Y</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Place of installation: Indoor/outdoor</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">Elektrische Daten:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Leistungsaufnahme P1: 1.25 kW</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Motortyp: PSC</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rated power - P2: 0.71 kW</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Netzfrequenz: 50 Hz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bemessungsspannung: 1 x 230 V</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Nennstrom: 5.44 A</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Cos phi - Leistungsfaktor: 0.98</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bemessungsdrehzahl: 2795 1/min</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Größe des Betriebskondensators: 16 µF/400 V</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schutzart (gemäß IEC 34-5): IP68</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Isolationsklasse (IEC 85): F</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Length of power cable: 10 m</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Art des Kabelsteckers: SCHUKO</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">Sonstiges:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Nettogewicht: 11.7 kg</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bruttogewicht: 12 kg</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">komplett montiert und elektrisch angeschlossen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/></Text><TextComplement MarkLbl="11" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">angeb. Fabr.:	 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;.........&#x27;</span></ComplBody><ComplTail><br/></ComplTail></TextComplement><TextComplement MarkLbl="12" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">Typ:			 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;.........&#x27;</span></ComplBody><ComplTail><br/></ComplTail></TextComplement></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Vertikale 1-stufige Schmutzwasserpumpe</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id14525" RNoPart="41"><Qty>1.000</Qty><QU>Stk</QU><Description><CompleteText><ComplTSB>Yes</ComplTSB><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Niveausteuerung Grauwasserhebeanlage</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Pumpensteuerung dient zur Füllstandsregelung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">des Pumpenbehälters mit den beiden Pumpen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bedienfeld an der Steuerung zum einstellen der unterschiedliche Schaltniveaus und Betriebsarten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">einschl. folgenden Funktionen:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Aufzeichnungsfunktion über die letzten Alarm und Störmeldungen</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Steuerung von 1 oder 2 Pumpen auf Basis der am Sensoreingang anliegenden Analogsignale (0-5 V, 0,5-3,5 V, 0-10 V, 0-20 mA, 4-20 mA) oder Digitalsignale (Schwimmerschalter)</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Unterstützung von bis zu fünf Steuerebenen für den Betrieb über analoge Niveausensoren oder über Schwimmerschalter</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Konfigurierbare Eingangs- und Ausgangsklemmen, die flexibel als Digitaleingang/-ausgang, Analogeingang oder Pt100/1000-Eingang genutzt werden können</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schutz vor einem Zusammenbrechen der Netzspannung bei gleichzeitigem Anlaufen der Pumpen nach einem Stromausfall durch Einschaltverzögerung</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schutz vor Druckstößen durch Blockieren und Verzögern eines schnellen Neustarts/gleichzeitigen Pumpenanlaufs</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Wahlmöglichkeit einer automatischen Alarmquittierung</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Einstellmöglichkeiten für Abschaltverzögerungen zur Anpassung an aktuelle Betriebsbedingungen</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anzeige des aktuellen Füllstands</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Alarmmeldung über integriertem Summer.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schnittstelle zur Ausgabe von Stör- und Betriebsmeldungen</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">Alarmmeldung bei:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Überlast (Förderleistung/Stromaufnahme)</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Trockenlauf</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Hohem Füllstand</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Phasenfolgefehler und Phasenausfall</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Sensorfehler oder widersprüchlichen Sensorwerten</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Eindringen von Flüssigkeit in den Motor</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Überlauf</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zu vielen Neustarts</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Überhitzung der Pumpe.</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">Art der Steuerung:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Strommessung (Ja/Nein): Ja</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">Technische Daten:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zulassungen: CE,EAC,UKCA,MOROCCO,RCM</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anzahl Pumpen: 2</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Werkstoffe:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schaltschrank: Kunststoff</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Installation:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Umgebungstemperatur: 30 °C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Cabinet mounting: Wandmontage</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Masseanschluss: N, PE</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">Elektrische Daten:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Netzfrequenz: 50 / 60 Hz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Nennspannung 2. Wert: 1 x 110-240 V [3 x 200-460 V]</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Nennstrom: 1-9 A</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Größe des Betriebskondensators: N/A µF</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Größe des Anlaufkondensators: N/A µF</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Einschaltart: Direct-on-line (DOL)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schutzart (gemäß IEC 34-5): IP54</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;"><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">Sonstiges</span><span style="font-size:10pt;font-family:Arial;">:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Nettogewicht: 2 kg</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bruttogewicht: 2.79 kg</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Versandvol.: 0.015 m³</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">komplett montiert und elektrisch angeschlossen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/></Text><TextComplement MarkLbl="11" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">angeb. Fabr.:	 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;.........&#x27;</span></ComplBody><ComplTail><br/></ComplTail></TextComplement><TextComplement MarkLbl="12" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">Typ:			 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;.........&#x27;</span></ComplBody><ComplTail/></TextComplement></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Niveausteuerung Grauwasserhebeanlage</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Remark ID="id6477"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Rohrbefestigung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Vor der Montageaufnahme ist mit dem Statiker ein Termin vor Ort zu vereinbaren, an dem die vorgesehenen Befestigungen und Verankerungen an den einzelnen Montageorten abgeklärt, geprüft und freigegeben werden. Der Aufwand hierfür ist in die Einheitspreise miteinzu­kalkulieren.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rohrbefestigung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Item ID="id6478" RNoPart="42"><RefDescr>Ref</RefDescr><Qty>12.000</Qty><QU>Stk</QU><Description><CompleteText><ComplTSB>Yes</ComplTSB><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rohrschelle NW DN 125</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">für die Befestigung von Schmutzwasserleitungen,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">mit flexiblem Anschlussgewinde M8/M10</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Verschlussschrauben mit Kombi-Kreuzschlitz mit Unverlierbarkeitsscheiben</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schallschutzgeprüft - mit hochelastischer Schallschutzeinlage</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">einschl. folgendem Zubehör:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gewindestab M10 verzinkt</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Sechskantmutter</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Unterlegscheibe</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Hammerkopfschraube</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Dübel</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">komplett montiert</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/></Text><TextComplement MarkLbl="11" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">angeb. Fabr.:	 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;.........&#x27;</span></ComplBody><ComplTail><br/></ComplTail></TextComplement><TextComplement MarkLbl="12" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">Typ:			 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;.........&#x27;</span></ComplBody><ComplTail/></TextComplement></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rohrschelle NW DN 125</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id6479" RNoPart="43"><RefDescr>Rep</RefDescr><RefRNo IDRef="id6478"/><Qty>65.000</Qty><QU>Stk</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rohrschelle DN 100</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rohrschelle DN 100</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id6480" RNoPart="44"><RefDescr>Rep</RefDescr><RefRNo IDRef="id6478"/><Qty>10.000</Qty><QU>Stk</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rohrschelle DN 70 </span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rohrschelle DN 70</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id6481" RNoPart="45"><RefDescr>Rep</RefDescr><RefRNo IDRef="id6478"/><Qty>22.000</Qty><QU>Stk</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rohrschelle DN 50 </span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rohrschelle DN 50</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id6489" RNoPart="46"><Qty>200.000</Qty><QU>kg</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Aufhänge- und Stützkonstruktion; Schienen, Konsolen,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Trägerkrallen etc. aus verzinktem Stahl, mit schall­dämmender Zwischenlage, einschl. Decken-/Mauer­werks­befestigung, befestigen mit Befestigungsmitteln mit bauaufsichtlichem Nachweis einschl. Bohrungen. Arbeitshöhe des Montageortes  2,5 bis 4,0m über der Standfläche des hierfür erforderlichen Gerüstes, Gerüst wird gesondert vergütet.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Abrechnung nach Einheitsgewichten.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Aufhänge- und Stützkonstruktion aus verzinktem Stahl, mit</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item></Itemlist></BoQBody></BoQCtgy><BoQCtgy ID="id6104" RNoPart="02"><LblTx><p><span>Wasserleitungen und Armaturen</span></p></LblTx><BoQBody><Itemlist><Remark ID="id6105"><Description><CompleteText><DetailTxt><Text><p style="text-align:justify;margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Lieferung und Montage umfasst die komplette Erstellung des Trinkwassernetzes. Es sind besonders die DIN- und Schallschutzbestimmungen zu beachten. Es sind nur Rohre von deutschen Herstellern zugelassen. In die Einheitspreise sind sämtliche Zuschläge für Dichtungsmaterial und Zuschnitt einzukalkulieren. Übergänge auf andere Rohr-Materialien sowie Verlängerungern usw. müssen ebenfalls im Rohr­Einheitspreis enthalten sein.</span></p><p style="text-align:justify;margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="text-align:justify;margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Leitungsverlegung erfolgt teilweise in 3 bis 8 m Höhe; Die Verlegung der Rohrleitungen hat rechtwinklig, geradlinig entsprechend den technischen Vorschriften zu erfolgen.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Lieferung und Montage umfasst die komplette Erstellung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Item ID="id6108" RNoPart="1"><RefDescr>Ref</RefDescr><Qty>3.000</Qty><QU>Stk</QU><Description><CompleteText><ComplTSB>Yes</ComplTSB><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Freistrom-Absperrventil, DN 15</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">mit Entleerung, AG</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">aus Edelstahl mit Entleerung und Isolierung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Mediumberührte Metallteile aus Edelstahl, wartungsfreie Spindelabdichtung mit selbstfettender EPDM-Lippen­dichtung, unter Druck austauschbar, EPDM-Sitzdichtung, Kegel drehbar gelagert, gegen Druckschläge gesichert, Außengewinde für flachdichtende Verschraubungen,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">einschl. Entleerung Spindel­gewinde außerhalb des Mediums, verschleißfester Ventilsitz aus Edelstahl, mit schwarzem Handrad, totraumfrei, mit Offenstellungs­anzeige, DVGW-Zulassung, ÖVGW-Zulassung, SVGW-Zulassung, WRAS-Zulassung, KIWA-Zulassung, VA-Zulassung, Kunststoffteile mit KTW- und W 270-Zulassung, nach  nach DIN EN ISO 3822 Klasse 1,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Druckstufe PN 16, max. Betriebstemperatur 110 °C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zubehör: Dämmschale 2-teilig</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">einschl. sämtlichem Übergangsmaterial liefern und montieren</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/></Text><TextComplement MarkLbl="11" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">angeb. Fabr.:	 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;.........&#x27;</span></ComplBody><ComplTail><br/></ComplTail></TextComplement><TextComplement MarkLbl="12" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">Typ:		 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;.........&#x27;</span></ComplBody><ComplTail/></TextComplement></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Freistrom-Absperrventil, DN 15</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">mit Entleerung, AG</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id6109" RNoPart="2"><RefDescr>Rep</RefDescr><RefRNo IDRef="id6108"/><Qty>2.000</Qty><QU>Stk</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Freistrom-Absperrventil DN 20</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Freistrom-Absperrventil DN 20</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id6110" RNoPart="3"><RefDescr>Rep</RefDescr><RefRNo IDRef="id6108"/><Qty>2.000</Qty><QU>Stk</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Freistrom-Absperrventil DN 25</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Freistrom-Absperrventil DN 25</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id6111" RNoPart="4"><RefDescr>Rep</RefDescr><RefRNo IDRef="id6108"/><Qty>4.000</Qty><QU>Stk</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Freistrom-Absperrventil DN 32</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Freistrom-Absperrventil DN 32</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id6112" RNoPart="5"><RefDescr>Rep</RefDescr><RefRNo IDRef="id6108"/><Qty>6.000</Qty><QU>Stk</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Freistrom-Absperrventil DN 40</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Freistrom-Absperrventil DN 40</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id6153" RNoPart="6"><RefDescr>Rep</RefDescr><RefRNo IDRef="id6108"/><Qty>2.000</Qty><QU>Stk</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Freistrom-Absperrventil DN 50</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Freistrom-Absperrventil DN 50</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id6113" RNoPart="7"><RefDescr>Ref</RefDescr><Qty>4.000</Qty><QU>Stk</QU><Description><CompleteText><ComplTSB>Yes</ComplTSB><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Freistrom-Absperrventil DN 80</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Druckstufe:  PN 16</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;font-family:Arial;">Nennweite:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">DN 80</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Trinkwasser geeignet</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Freistrom-Kombi-Rückflussverhinderer, mit Entleer­stopfen, Flanschanschluss DN80/16, mediumberührte Metallteile aus entzinkungsfreiem und korrosions­beständigem Rotguss, beständig gegen aggressives Wasser, wartungsfreie Spindelabdichtung mit selbst­fettender EPDM-Lippendichtung, EPDM- Sitzdichtung,</span><br/><span>mit Entleerstopfen, mit Prüfein­richtung, Rückfluss­verhinderer mit Edelstahl- Schließfeder, mit schwarzem Handrad, totraumfrei, für waagerechten und senkrechten Einbau geeignet, mit Absperrfunktion zur Wartung, mit Offenstellungsanzeige, nach DVGW-Bestimmungen, Kunststoffteile mit KTW- und W 270-Zulassung, nach UBA-Bewertungsgrundlage, gem. DIN EN 13959- Bestimmungen,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">ÜA-Reg.-Nr. R-15.2.3-21-17048, WIEN-ZERT, Druckstufe PN 16, max. Betriebstemperatur 100 °C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><s