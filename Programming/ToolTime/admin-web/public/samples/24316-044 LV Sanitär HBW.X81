tem><Item ID="id2095" RNoPart="36"><Qty>4.000</Qty><QU>Stk</QU><Description><CompleteText><ComplTSB>Yes</ComplTSB><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Duschklappsitz, rechteckig</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">aus hochwertigem Edelstahl poliert mit einteiliger HPL-Sitzfläche, von der Unterseite verschraubt</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">dient zum sicheren Sitzen im Duschbereich</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">kann hochgeklappt werden</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Wandanbindung aus Edelstahl</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Wartungsarme Bremsen des Duschsitzes ermöglichen, dass die Sitzfläche nach dem Hochklappen in einer aufrechten Position stehen bleibt</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zusätzliche Wandabstützung über einen hochwertigen, polierten Edelstahlbügel mit polierter Edelstahl-Wandkonsole</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">20 1/16 inch (510 mm) breit und 15 3/4 inch</span><br/><span>(400 mm) tief</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">maximale Belastbarkeit 204 kg</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">erfüllt die Anforderungen nach 2010 ADA Standards und ICC/ANSI A117.1-2017</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">einschl. Befestigungsmaterial</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/></Text><TextComplement MarkLbl="11" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">angeb. Fabr.:	 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;.........&#x27;</span></ComplBody><ComplTail><br/></ComplTail></TextComplement><TextComplement MarkLbl="12" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">Typ:			 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;.........&#x27;</span></ComplBody><ComplTail/></TextComplement></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Duschklappsitz, rechteckig</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2096" RNoPart="37"><Qty>5.000</Qty><QU>Stk</QU><Description><CompleteText><ComplTSB>Yes</ComplTSB><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Kristallglasspiegel, 650 x 600 mm, Splitterschutz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">rechteckiger Spiegel mit geschliffenen Kanten</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Spiegel aus hochwertigem Kristallglas mit Splitterschutzfolie</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><