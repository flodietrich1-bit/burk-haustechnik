ext><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Übergangsstück mit AG/IG 88,9 x 2,0 mm </span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Übergangsstück mit AG/IG 88,9 x 2,0 mm</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id6144" RNoPart="64"><RefDescr>Rep</RefDescr><RefRNo IDRef="id6139"/><Qty>10.000</Qty><QU>Stk</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Flansch DN80/PN10 mit Pressmuffe</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">einschl. Schrauben, Dichtungen und Muttern</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Flansch DN80/PN10 mit Pressmuffe</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Remark ID="id6145"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;font-weight:bold;text-decoration:underline ;"><span style="font-family:Arial;font-size:10pt;">Anschlussleitungen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Metallverbundrohr</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anschlussleitungen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Item ID="id6146" RNoPart="65"><RefDescr>Ref</RefDescr><Qty>30.000</Qty><QU>m</QU><Description><CompleteText><ComplTSB>Yes</ComplTSB><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Metallverbundrohr 16 x 2,25 mm (DN 12)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Leitungsrohre aus Metallverbundrohr,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">in Stangen, mit Prüfzeichen DVGW TS 225 (N 011).</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Besteht aus Polyethylen erhöhter Temperatur­beständigkeit (PE-RT II), einem stumpf verschweißtem Tragrohr aus Aluminium und einer äußeren Schutz­schicht aus Polyethylen erhöhter Temperatur­beständigkeit (PE-RT II), UV-stabilisiert,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">längskraftschlüssige Verbindung durch direktes Verpressen des Rohres auf das Fitting ohne Hülse, Rohrenden hygienisch verschlossen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Leitungsrohre gem. den Anforderungen des DVGW-</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Arbeitsblattes W 541, oder gleichwertig.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rohrver­bindungen mittels Pressfittings aus Rotguss mit dem Prüfzeichen DVGW TS 225 herstellen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zuschläge für Verschnitt und das Verpressen sind in die Einheits­preise einzurechnen. Als Anschlussleitungen in den Vorwänden und auf dem Boden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"/></Text><TextComplement MarkLbl="11" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">angeb. Fabr.:	 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;.........&#x27;</span></ComplBody><ComplTail><br/></ComplTail></TextComplement><TextComplement MarkLbl="12" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">Typ:		 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;.........&#x27;</span></ComplBody><ComplTail/></TextComplement></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Metallverbundrohr 16 x 2,25 mm (DN 12)</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id6147" RNoPart="66"><RefDescr>Rep</RefDescr><RefRNo IDRef="id6146"/><Qty>15.000</Qty><QU>m</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">System-Rohr 20 x 2,5 mm (DN15)</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">System-Rohr 20 x 2,5 mm (DN15)</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id6148" RNoPart="67"><RefDescr>Rep</RefDescr><RefRNo IDRef="id6146"/><Qty>15.000</Qty><QU>m</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:255pt;font-size:10pt;"><span st