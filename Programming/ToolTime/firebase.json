{
  "apphosting": {
    "backendId": "burk-haustechnik",
    "rootDir": "admin-web",
    "ignore": [
      "node_modules",
      ".git",
      "admin-web/dist",
      "backend",
      "docs",
      "*.log",
      ".env",
      ".env.*"
    ],
    "alwaysDeployFromSource": true
  },
  "hosting": {
    "public": "admin-web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "backend/firestore.rules"
  },
  "storage": {
    "rules": "backend/storage.rules"
  },
  "emulators": {
    "auth": {
      "host": "0.0.0.0",
      "port": 9099
    },
    "firestore": {
      "host": "0.0.0.0",
      "port": 8085
    },
    "storage": {
      "host": "0.0.0.0",
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "host": "0.0.0.0",
      "port": 4000
    },
    "singleProjectMode": true
  }
}
